<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- For bundled tools that load the ffmpeg dylibs from Frameworks but
       never open the microphone (ffprobe). Ad hoc, every Mach-O is signed
       with no Team ID, and the hardened runtime's library validation then
       refuses the dylibs: ffprobe died at launch and the player showed
       00:00. Drop with the same condition as entitlements.plist (plan 08). -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
