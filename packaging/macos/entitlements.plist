<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: microphone. Also given to momr-audio and ffmpeg,
       which open the microphone in their own processes. -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- bundle-macos.sh re-signs the dylibs it copies into Frameworks, but GTK
       and GIO can still load plug-in modules from Homebrew's prefix at run
       time, which are not ours. Drop this once a signed build shows every
       loaded library comes from the bundle (plan 08). -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
